---
import SectionHeading from '@/components/SectionHeading.astro'
import { experience } from '@/data/experience'
import { useI18n } from '@/i18n'
import type { Locale } from '@/types/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { t, l } = useI18n(locale)
const f = t.about.facts

const facts = [
  { stat: 'EXP', label: f.tenureLabel, value: f.tenureValue },
  { stat: 'PATH', label: f.pathLabel, value: f.pathValue },
  { stat: 'LDR', label: f.leadershipLabel, value: f.leadershipValue },
  { stat: 'INT', label: f.degreeLabel, value: f.degreeValue },
  { stat: 'XP+', label: f.postgradLabel, value: f.postgradValue },
  { stat: 'AGE', label: f.ageLabel, value: f.ageValue },
]

// Oldest → newest, freelance excluded: it's work, not a rung of the ladder.
const track = experience
  .filter((item) => item.kind !== 'freelance')
  .flatMap((item) => [...item.roles].reverse())
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container">
    <SectionHeading
      t={t}
      stage={4}
      stageName={t.game.stages.about}
      heading={t.about.heading}
      headingId="about-heading"
    />

    <div class="sheet">
      <div class="body" data-reveal>
        {t.about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="stats panel" data-reveal style="--reveal-delay: 80ms">
        <p class="stats-title only-8bit" aria-hidden="true">STATUS</p>
        <dl>
          {
            facts.map((fact) => (
              <div class="row">
                <dt>
                  <span class="stat only-8bit" aria-hidden="true">
                    {fact.stat}
                  </span>
                  <span class="dt-label">{fact.label}</span>
                </dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="track" data-reveal>
      <p class="kicker">{t.career.label}</p>
      <ol class="steps" aria-label={t.career.a11yLabel}>
        {
          track.map((role, index) => (
            <li class:list={['step', { now: index === track.length - 1 }]}>
              <span class="step-lv">
                {t.game.level} {index + 1}
              </span>
              <span class="step-title">{l(role.title)}</span>
              <span class="step-year">{role.startDate.slice(0, 4)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .sheet {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  @media (min-width: 64rem) {
    .sheet {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .body {
    display: grid;
    gap: 1.25rem;
    max-width: var(--prose-max);
    color: var(--fg-2);
    font-size: var(--text-lead);
  }

  :global([data-mode='4k']) .body {
    line-height: 1.55;
  }

  :global([data-mode='4k']) .body p:first-child {
    color: var(--fg);
  }

  .stats {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  :global([data-mode='8bit']) .stats {
    background: var(--c-night);
    --panel-line: var(--c-paper);
  }

  .stats-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  dl {
    display: grid;
  }

  .row {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--line);
  }

  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .row:last-child {
    padding-bottom: 0;
  }

  dt {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  :global([data-mode='4k']) dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
  }

  .stat {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    color: var(--accent);
    min-width: 4.5em;
  }

  dd {
    color: var(--fg);
  }

  :global([data-mode='8bit']) .row {
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    border-top: 0;
    padding-block: 0.375rem;
  }

  :global([data-mode='8bit']) .dt-label {
    display: none;
  }

  :global([data-mode='8bit']) dd {
    /* Dotted leader between stat and value, like an RPG menu. */
    background: radial-gradient(circle, var(--line) 2px, transparent 2.5px) 0 0.7em / 10px 4px repeat-x;
  }

  /* --- career track --- */

  .track {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    display: grid;
    gap: 1.25rem;
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .step {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    background: var(--bg-raised);
    border-radius: calc(var(--radius) * 0.6);
    position: relative;
  }

  .step-lv {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    color: var(--fg-muted);
  }

  :global([data-mode='4k']) .step-lv {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .step-title {
    color: var(--fg);
    font-size: var(--text-sm);
  }

  .step-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .step.now {
    background: var(--accent);
  }

  .step.now > * {
    color: var(--accent-fg);
  }

  :global([data-mode='8bit']) .step {
    margin: 4px;
    box-shadow:
      0 -4px 0 0 var(--line),
      0 4px 0 0 var(--line),
      -4px 0 0 0 var(--line),
      4px 0 0 0 var(--line);
  }

  :global([data-mode='8bit']) .step.now {
    box-shadow:
      0 -4px 0 0 var(--c-shadow),
      0 4px 0 0 var(--c-shadow),
      -4px 0 0 0 var(--c-shadow),
      4px 0 0 0 var(--c-shadow),
      inset -4px -4px 0 0 var(--c-gold-lo);
  }

  :global([data-mode='4k']) .step {
    border: var(--border);
  }

  :global([data-mode='4k']) .step.now {
    border-color: transparent;
    box-shadow: 0 10px 30px -12px color-mix(in oklch, var(--accent) 70%, transparent);
  }
</style>
