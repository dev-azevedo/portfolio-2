---
import { Image } from 'astro:assets'

import SectionHeading from '@/components/SectionHeading.astro'
import { experience } from '@/data/experience'
import { useI18n } from '@/i18n'
import type { ExperienceItem, ExperienceRole, Locale } from '@/types/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { t, l, formatDate } = useI18n(locale)

interface Level {
  id: string
  item: ExperienceItem
  role: ExperienceRole
  /** LV number on the ladder; `null` for side quests (freelance). */
  level: number | null
  current: boolean
}

const levels: Level[] = experience.flatMap((item) => {
  const ladder = item.kind !== 'freelance'
  return item.roles.map((role, index) => ({
    id: `${item.id}-${index}`,
    item,
    role,
    level: ladder ? item.roles.length - index : null,
    current: ladder && index === 0,
  }))
})
const ladder = levels.filter((lv) => lv.level !== null)
const side = levels.filter((lv) => lv.level === null)

const year = (iso: string | null) => (iso ? iso.slice(0, 4) : t.experience.present)
---

<section id="experience" class="section" aria-labelledby="experience-heading">
  <div class="container">
    <SectionHeading
      t={t}
      stage={1}
      stageName={t.game.stages.experience}
      heading={t.experience.heading}
      headingId="experience-heading"
      deck={t.experience.deck}
    />

    <div class="map" data-tabs data-reveal>
      <div class="levels" role="tablist" aria-label={t.career.a11yLabel} aria-orientation="vertical">
        {
          [...ladder, ...side].map((lv, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${lv.id}`}
              aria-controls={`panel-${lv.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              class:list={['level', { side: lv.level === null, current: lv.current }]}
            >
              <span class="lv-num">
                {lv.level === null ? '★' : `${t.game.level} ${lv.level}`}
              </span>
              <span class="lv-title">{l(lv.role.title)}</span>
              <span class="lv-year">
                {year(lv.role.startDate)}
                {lv.current && <span class="sr-only">, {t.experience.currentBadge}</span>}
              </span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        {
          [...ladder, ...side].map((lv, index) => (
            <article
              role="tabpanel"
              id={`panel-${lv.id}`}
              aria-labelledby={`tab-${lv.id}`}
              tabindex="0"
              class:list={['dialog panel', { 'is-active': index === 0 }]}
            >
              <header class="dlg-head">
                {lv.item.logo ? (
                  <Image src={lv.item.logo} alt="" width={48} height={48} class="logo" />
                ) : (
                  <span class="logo logo-fallback" aria-hidden="true">
                    ★
                  </span>
                )}
                <div>
                  <p class="company">
                    {lv.item.url ? (
                      <a href={lv.item.url} target="_blank" rel="noopener noreferrer" class="link">
                        {lv.item.companyLabel ? l(lv.item.companyLabel) : lv.item.company}
                        <span class="sr-only"> {t.a11y.newTab}</span>
                      </a>
                    ) : lv.item.companyLabel ? (
                      l(lv.item.companyLabel)
                    ) : (
                      lv.item.company
                    )}
                  </p>
                  <p class="tagline">{l(lv.item.companyTagline)}</p>
                </div>
              </header>

              <div class="dlg-title">
                <h3>{l(lv.role.title)}</h3>
                <p class="dates">
                  <time datetime={lv.role.startDate}>{formatDate(lv.role.startDate)}</time>
                  {' – '}
                  {lv.role.endDate ? (
                    <time datetime={lv.role.endDate}>{formatDate(lv.role.endDate)}</time>
                  ) : (
                    <span>{t.experience.present}</span>
                  )}
                </p>
                {lv.current && (
                  <p class="badge">
                    <span class="only-8bit">{t.game.current}</span>
                    <span class="only-4k">{t.experience.currentBadge}</span>
                  </p>
                )}
              </div>

              <ul class="bullets">
                {l(lv.role.bullets).map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              {!lv.current && lv.level !== null && (
                <p class="clear only-8bit" aria-hidden="true">
                  ★ {t.game.clear} ★
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { play } from '@/scripts/sound'

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!)

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index
        tab.setAttribute('aria-selected', String(active))
        tab.tabIndex = active ? 0 : -1
        panels[i]!.classList.toggle('is-active', active)
      })
      if (focus) tabs[index]!.focus()
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index))
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        }
        const next = keys[event.key]
        if (next === undefined) return
        event.preventDefault()
        select((next + tabs.length) % tabs.length, true)
        play('blip')
      })
    })
  })
</script>

<style>
  .map {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 56rem) {
    .map {
      grid-template-columns: minmax(18rem, 25rem) minmax(0, 1fr);
      align-items: start;
      gap: 2rem;
    }
  }

  /* --- level list --- */

  .levels {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 6px 6px 12px;
    margin-inline: -6px;
    scrollbar-width: thin;
  }

  @media (min-width: 56rem) {
    .levels {
      flex-direction: column;
      overflow: visible;
      padding: 0;
      margin: 0;
      position: relative;
    }
  }

  .level {
    flex: none;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.625rem 0.875rem;
    text-align: left;
    color: var(--fg-2);
    border-radius: calc(var(--radius) * 0.6);
    position: relative;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .level.side {
    margin-top: 0.75rem;
  }

  .lv-num {
    font-family: var(--font-display);
    font-size: 0.625rem;
    color: var(--fg-muted);
    min-width: 5.5em;
    white-space: nowrap;
  }

  .level {
    max-width: min(17rem, 78vw);
  }

  @media (min-width: 56rem) {
    .level {
      max-width: none;
    }
  }

  .lv-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .level[aria-selected='true'] {
    color: var(--fg);
    background: var(--bg-raised);
  }

  .level[aria-selected='true'] .lv-num {
    color: var(--accent);
  }

  .level.current .lv-num::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 0.5em;
    background: var(--ok);
    vertical-align: middle;
  }

  @media (hover: hover) {
    .level:hover {
      color: var(--fg);
    }
  }

  /* 8-BIT: levels sit on a dotted "world map" path. */
  :global([data-mode='8bit']) .level {
    font-size: var(--text-base);
  }

  :global([data-mode='8bit']) .level[aria-selected='true'] {
    background: var(--c-dusk);
    margin: 4px;
    box-shadow:
      0 -4px 0 0 var(--accent),
      0 4px 0 0 var(--accent),
      -4px 0 0 0 var(--accent),
      4px 0 0 0 var(--accent);
  }

  :global([data-mode='8bit']) .level[aria-selected='true'] .lv-num::before {
    content: '▶ ';
  }

  @media (min-width: 56rem) {
    :global([data-mode='8bit']) .levels::before {
      content: '';
      position: absolute;
      left: 1.6rem;
      top: 1rem;
      bottom: 4.5rem;
      width: 4px;
      background: repeating-linear-gradient(var(--line) 0 8px, transparent 8px 16px);
      z-index: -1;
    }

    :global([data-mode='4k']) .levels::before {
      content: '';
      position: absolute;
      left: 2.15rem;
      top: 1.5rem;
      bottom: 5rem;
      width: 1px;
      background: linear-gradient(var(--accent), var(--line) 60%);
      z-index: -1;
    }
  }

  :global([data-mode='4k']) .level {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  :global([data-mode='4k']) .lv-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  :global([data-mode='4k']) .level[aria-selected='true'] {
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow);
  }

  :global([data-mode='4k']) .level.current .lv-num::after {
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--ok) 25%, transparent);
  }

  /* --- dialog panel --- */

  :global(.js) .dialog:not(.is-active) {
    display: none;
  }

  .panels {
    display: grid;
    gap: 1.5rem;
  }

  .dialog {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  :global([data-mode='8bit']) .dialog {
    background: var(--c-night);
    --panel-line: var(--c-paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dialog.is-active {
      animation: panel-in var(--dur) var(--ease) both;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .dlg-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .logo {
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: calc(var(--radius) * 0.5);
    object-fit: cover;
  }

  :global([data-mode='8bit']) .logo {
    image-rendering: pixelated;
    box-shadow: 0 0 0 4px var(--line);
  }

  .logo-fallback {
    display: grid;
    place-items: center;
    background: var(--bg-raised);
    color: var(--accent);
  }

  .company {
    font-weight: 600;
    color: var(--fg);
  }

  .tagline {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .dlg-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }

  :global([data-mode='8bit']) .dlg-title {
    border-block: 4px dashed var(--line);
  }

  h3 {
    font-size: var(--text-h3);
    flex-basis: 100%;
  }

  :global([data-mode='8bit']) h3 {
    color: var(--accent);
    line-height: 1.6;
  }

  :global([data-mode='4k']) h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 650;
  }

  .dates {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .badge {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    padding: 0.375rem 0.5rem;
    background: var(--ok);
    color: var(--c-night);
  }

  :global([data-mode='4k']) .badge {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklch, var(--ok) 16%, transparent);
    color: var(--ok);
  }

  .bullets {
    display: grid;
    gap: 0.875rem;
    max-width: var(--prose-max);
  }

  .bullets li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--fg-2);
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  :global([data-mode='8bit']) .bullets li::before {
    top: 0.45em;
  }

  :global([data-mode='4k']) .bullets li::before {
    width: 6px;
    height: 6px;
    top: 0.65em;
    border-radius: 50%;
  }

  .clear {
    font-family: var(--font-display);
    font-size: 0.625rem;
    color: var(--ok);
    text-align: center;
  }
</style>
