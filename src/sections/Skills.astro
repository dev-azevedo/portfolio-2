---
import SectionHeading from '@/components/SectionHeading.astro'
import TechChip from '@/components/TechChip.astro'
import { skillGroups, skillsByGroup } from '@/data/skills'
import { useI18n } from '@/i18n'
import type { Locale } from '@/types/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { t } = useI18n(locale)
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <div class="container">
    <SectionHeading
      t={t}
      stage={3}
      stageName={t.game.stages.skills}
      heading={t.skills.heading}
      headingId="skills-heading"
      deck={t.skills.deck}
    />

    <div class="bags">
      {
        skillGroups.map((group, index) => (
          <section
            class="bag"
            aria-labelledby={`skills-${group}`}
            data-group={group}
            data-reveal
            style={`--reveal-delay: ${index * 50}ms`}
          >
            <div class="bag-head">
              <h3 id={`skills-${group}`}>
                <span class="bag-mark" aria-hidden="true" />
                {t.skills.groups[group]}
                <span class="bag-count" aria-hidden="true">
                  ×{skillsByGroup(group).length}
                </span>
              </h3>
              <p>{t.skills.groupDecks[group]}</p>
            </div>
            <ul class="slots">
              {skillsByGroup(group).map((skill) => (
                <li>
                  <TechChip skill={skill} variant="slot" />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="also" data-reveal>{t.skills.also}</p>
  </div>
</section>

<style>
  .bags {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .bag {
    display: grid;
    gap: 1.25rem;
    --mark: oklch(0.72 0.15 var(--hue));
  }

  .bag[data-group='languages'] {
    --hue: 300;
  }
  .bag[data-group='backend'] {
    --hue: 250;
  }
  .bag[data-group='frontend'] {
    --hue: 195;
  }
  .bag[data-group='data'] {
    --hue: 150;
  }
  .bag[data-group='infra'] {
    --hue: 45;
  }

  @media (min-width: 56rem) {
    .bag {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
      padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
      border-top: 1px solid var(--line);
    }
    .bag:first-child {
      border-top: 0;
      padding-top: 0;
    }
    :global([data-mode='8bit']) .bag {
      border-top: 4px dashed var(--line);
    }
    :global([data-mode='8bit']) .bag:first-child {
      border-top: 0;
    }
  }

  .bag-head {
    display: grid;
    gap: 0.5rem;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-h3);
  }

  :global([data-mode='4k']) h3 {
    font-size: 1.375rem;
    font-weight: 650;
  }

  .bag-mark {
    width: 12px;
    height: 12px;
    flex: none;
    background: var(--mark);
  }

  :global([data-mode='4k']) .bag-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--mark) 22%, transparent);
  }

  .bag-count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    font-weight: 400;
  }

  :global([data-mode='8bit']) .bag-count {
    font-size: 1.25rem;
  }

  .bag-head p {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    max-width: 40ch;
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }

  .slots li {
    display: grid;
  }

  .also {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    max-width: var(--prose-max);
    color: var(--fg-2);
    font-size: var(--text-lead);
  }

  :global([data-mode='4k']) .also {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
</style>
