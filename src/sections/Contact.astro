---
import Icon from '@/components/Icon.astro'
import { socials } from '@/data/socials'
import { useI18n } from '@/i18n'
import type { Locale } from '@/types/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { t, l } = useI18n(locale)
---

<section id="contact" class="section contact" aria-labelledby="contact-heading">
  <div class="container">
    <p class="kicker" data-reveal>
      <span class="kicker-num"><span class="only-8bit">{t.game.stage} </span>05</span>{' '}
      <span class="rule" aria-hidden="true"></span>{' '}
      <span>{t.game.stages.contact}</span>
    </p>

    <div class="stage" data-reveal>
      <div class="countdown only-8bit" aria-hidden="true">
        <span class="digit"></span>
      </div>
      <h2 id="contact-heading">{t.contact.heading}</h2>
    </div>

    <ul class="menu" data-reveal>
      {
        socials.map((link) => (
          <li>
            <a
              href={link.href}
              class="item"
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="cursor only-8bit" aria-hidden="true">
                ▶
              </span>
              <Icon name={link.icon} class="item-icon" />
              <span class="item-label">{l(link.label)}</span>
              <Icon name="lucide:arrow-up-right" class="item-arrow only-4k" />
              {link.external && <span class="sr-only">{t.a11y.newTab}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(5rem, 4rem + 6vw, 10rem);
  }

  .rule {
    width: 2.5rem;
    height: 4px;
    background: currentColor;
  }

  :global([data-mode='4k']) .rule {
    height: 1px;
    background: var(--line-strong);
  }

  .stage {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    margin-block: 1.25rem clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  h2 {
    font-size: var(--text-display);
    max-width: 16ch;
  }

  :global([data-mode='8bit']) h2 {
    font-size: clamp(1.25rem, 0.8rem + 2.2vw, 2.5rem);
    text-shadow: 4px 4px 0 var(--c-shadow);
  }

  :global([data-mode='4k']) h2 {
    font-weight: 700;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6rem);
  }

  .countdown {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(4rem, 3rem + 4vw, 6rem);
    aspect-ratio: 1;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    color: var(--c-coral);
    background: var(--c-night);
    box-shadow:
      0 -4px 0 0 var(--c-coral),
      0 4px 0 0 var(--c-coral),
      -4px 0 0 0 var(--c-coral),
      4px 0 0 0 var(--c-coral);
    margin: 4px;
  }

  /* 9 → 0, one tick per second, then holds — the arcade continue screen. */
  .digit::before {
    content: '9';
  }

  /* Starts when the stage scrolls into view, not on page load. */
  @media (prefers-reduced-motion: no-preference) {
    .is-revealed .digit::before {
      animation: countdown 10s steps(1, end) forwards;
    }
  }

  @keyframes countdown {
    0% { content: '9'; }
    10% { content: '8'; }
    20% { content: '7'; }
    30% { content: '6'; }
    40% { content: '5'; }
    50% { content: '4'; }
    60% { content: '3'; }
    70% { content: '2'; }
    80% { content: '1'; }
    90%, 100% { content: '0'; }
  }

  .menu {
    display: grid;
    max-width: 48rem;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 0.25rem;
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-lead);
    border-top: 1px solid var(--line);
    transition: color var(--dur) var(--ease);
  }

  li:last-child .item {
    border-bottom: 1px solid var(--line);
  }

  .item :global(.item-icon) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--fg-muted);
  }

  .item-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global([data-mode='4k']) .item {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.015em;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .item :global(.item-arrow) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--fg-muted);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  :global([data-mode='8bit']) .item {
    border: 0;
    padding-block: 0.625rem;
  }

  .cursor {
    color: var(--accent);
    visibility: hidden;
    width: 1em;
  }

  .item:focus-visible .cursor {
    visibility: visible;
  }

  @media (hover: hover) {
    .item:hover {
      color: var(--accent);
    }
    .item:hover .cursor {
      visibility: visible;
    }
    .item:hover :global(.item-arrow) {
      color: var(--accent);
      transform: translate(4px, -4px);
    }
  }
</style>
