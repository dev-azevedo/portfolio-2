---
import type { Messages } from '@/i18n'

interface Props {
  t: Messages
}

const { t } = Astro.props
---

<!--
  Each button is drawn in its own mode's typeface, so the switch previews what
  it does. aria-pressed is synced by app.ts after the pre-paint script ran.
-->
<div class="mode-switch" role="group" aria-label={t.mode.group}>
  <button type="button" class="opt opt-8bit" data-mode-set="8bit" aria-pressed="true">
    <span aria-hidden="true">8-BIT</span>
    <span class="sr-only">{t.mode.bit}</span>
  </button>
  <button type="button" class="opt opt-4k" data-mode-set="4k" aria-pressed="false">
    <span aria-hidden="true">4K</span>
    <span class="sr-only">{t.mode.hd}</span>
  </button>
</div>

<style>
  .mode-switch {
    display: inline-flex;
    align-items: stretch;
    padding: 3px;
    gap: 3px;
    background: var(--bg-sunken);
    border-radius: var(--radius-pill);
    flex: none;
  }

  .opt {
    min-height: 2.25rem;
    min-width: 3.25rem;
    padding-inline: 0.75rem;
    color: var(--fg-muted);
    border-radius: var(--radius-pill);
    touch-action: manipulation;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .opt-8bit {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.75rem;
    -webkit-font-smoothing: none;
  }

  .opt-4k {
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    -webkit-font-smoothing: antialiased;
  }

  .opt[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-fg);
  }

  @media (hover: hover) {
    .opt[aria-pressed='false']:hover {
      color: var(--fg);
    }
  }

  :global([data-mode='8bit']) .mode-switch {
    box-shadow:
      0 -4px 0 0 var(--line),
      0 4px 0 0 var(--line),
      -4px 0 0 0 var(--line),
      4px 0 0 0 var(--line);
    margin: 4px;
  }

  :global([data-mode='8bit']) .opt[aria-pressed='true'] {
    box-shadow:
      inset -3px -3px 0 0 var(--c-gold-lo),
      inset 3px 3px 0 0 var(--accent-hi);
  }

  :global([data-mode='4k']) .mode-switch {
    border: var(--border);
    box-shadow: inset 0 1px 2px oklch(0 0 0 / 0.12);
  }

  :global([data-mode='4k']) .opt[aria-pressed='true'] {
    box-shadow:
      0 1px 0 0 oklch(1 0 0 / 0.25) inset,
      0 4px 14px -4px color-mix(in oklch, var(--accent) 70%, transparent);
  }
</style>
