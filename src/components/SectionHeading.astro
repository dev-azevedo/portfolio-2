---
import type { Messages } from '@/i18n'

interface Props {
  t: Messages
  /** 1-based stage number, shown as "STAGE 01" / "01". */
  stage: number
  /** Game-flavoured name of the stage, e.g. "Career map". */
  stageName: string
  heading: string
  headingId: string
  deck?: string
}

const { t, stage, stageName, heading, headingId, deck } = Astro.props
const num = String(stage).padStart(2, '0')
---

<div class="heading" data-reveal>
  <p class="kicker">
    <span class="kicker-num"><span class="only-8bit">{t.game.stage} </span>{num}</span>{' '}
    <span class="rule" aria-hidden="true"></span>{' '}
    <span>{stageName}</span>
  </p>
  <h2 id={headingId}>{heading}</h2>
  {deck && <p class="deck">{deck}</p>}
</div>

<style>
  .heading {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
    max-width: 48rem;
  }

  .rule {
    width: 2.5rem;
    height: 4px;
    background: currentColor;
  }

  :global([data-mode='4k']) .rule {
    height: 1px;
    background: var(--line-strong);
  }

  h2 {
    font-size: var(--text-h2);
  }

  :global([data-mode='4k']) h2 {
    font-weight: 700;
  }

  :global([data-mode='8bit']) h2 {
    text-shadow: 4px 4px 0 var(--c-shadow);
  }

  .deck {
    color: var(--fg-2);
    font-size: var(--text-lead);
    max-width: var(--prose-max);
  }

  :global([data-mode='4k']) .deck {
    line-height: 1.5;
  }
</style>
